{
  "name": "wardrobe-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "qa": "node qa/check-project.mjs && node --test server/tests/*.test.cjs server/tests/*.test.js",
    "test:wardrobe:unit-components": "vitest run --config tests/wardrobe-outfit-planner/vitest.config.js",
    "test:wardrobe:e2e": "pnpm build && playwright test --config tests/wardrobe-outfit-planner/playwright.config.js",
    "test:wardrobe": "pnpm test:wardrobe:unit-components && pnpm test:wardrobe:e2e",
    "test:business": "vitest run",
    "test:business:e2e": "playwright test --config tests/business/e2e/playwright.config.js",
    "test:stylefeed-outfitRequest": "vitest run --config tests/stylefeed-outfitRequest/vitest.config.js",
    "test:stylefeed-outfitRequest:e2e": "playwright test --config tests/stylefeed-outfitRequest/e2e/playwright.config.js",
    "test:profile-admin:unit-components": "vitest run tests/profile-admin/unit tests/profile-admin/component",
    "test:profile-admin:e2e": "playwright test --config tests/profile-admin/e2e/playwright.config.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/ui": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "vite": "^8.3.2",
    "vitest": "^5.1.0"
  }
}
